{
  "manifest_version": 3,
  "name": "Relay AI — GitHub Assistant",
  "version": "0.3.0",
  "description": "Relay AI Project Manager for GitHub.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://relay-standalone-backend.onrender.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "Open Relay AI",
    "default_icon": {
      "16": "icons/relay-16.png",
      "32": "icons/relay-32.png"
    }
  },

  "icons": {
    "16": "icons/relay-16.png",
    "32": "icons/relay-32.png",
    "48": "icons/relay-48.png",
    "128": "icons/relay-128.png"
  },

  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "context.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "panel.html",
        "panel.css",
        "panel.js",
        "context.js",
        "assistant-client.js"
      ],
      "matches": [
        "https://github.com/*"
      ]
    }
  ],

  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src https://relay-standalone-backend.onrender.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
  }
}